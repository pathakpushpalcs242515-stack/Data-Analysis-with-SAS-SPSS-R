library(ggplot2)
library(dplyr)

ai_data <- read.csv("~/pushpal/AirPassengers.csv")
colnames(ai_data) <- c("Month_Str", "Passengers")

ai_data <- ai_data %>%
  mutate(
    Year = as.numeric(substr(Month_Str, 1, 4)),
    Month_Num = as.numeric(substr(Month_Str, 6, 7))
  )

numeric_cols <- ai_data %>%
  select(Year, Month_Num, Passengers) %>%
  na.omit()

cor_matrix <- cor(numeric_cols)

print("Correlation_Matrix")
print(round(cor_matrix, 2)) 

col_palette <- colorRampPalette(c("#BB4444", "#EE9988", "#FFFFFF", "#77AADD", "#4477AA"))(200)

heatmap(cor_matrix, 
        col = col_palette, 
        main = "Correlation Heatmap",
        Rowv = NA, Colv = NA, 
        symm = TRUE,
        margins = c(12, 12), 
        cexRow = 1.2, cexCol = 1.2) 
